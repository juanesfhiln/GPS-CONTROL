# PostgreSQL
DB_USER=usuario_postgres
DB_PASSWORD=contraseña_postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gps_control

# Seguridad de sesión y JWT
JWT_SECRET_KEY=REEMPLAZAR_POR_UN_SECRETO_ALEATORIO_LARGO
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Orígenes permitidos por CORS y CSRF (separar varios con coma)
FRONTEND_ORIGINS=http://localhost:5173

# Wialon
WIALON_API_URL=https://host-de-wialon/wialon/ajax.html
WIALON_TOKEN=REEMPLAZAR_POR_TOKEN_DE_WIALON
WIALON_RESOURCE_ID=ID_DEL_RECURSO_WIALON

# Usuario administrador inicial (utilizado por python -m app.seed)
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CAMBIAR_POR_UNA_CONTRASENA_SEGURA
